{
  "business_domain": "string (e.g., Commercial Sales, Procurement & Supply Chain, Human Capital, Financial Accounting, IT Operations)",
  "data_tier": "string (analytics_mart | staging_raw | operational_oltp | dimension | historical_archive)",
